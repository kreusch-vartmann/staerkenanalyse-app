# Python Byte-Code und Caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtuelle Umgebung
venv/
.venv/
env/

# Datenbank-Dateien
database.db
*.sqlite
*.sqlite3

# Umgebungs-Variablen
.env
*.env.*

# Projekt-spezifische Daten-Dateien
data.json
settings.json

# Upload-Verzeichnisse (Benutzer-generierte Logos/Signaturen, nicht versionieren)
uploads/*
!uploads/.gitkeep
!uploads/logos/.gitkeep
!uploads/signatures/.gitkeep

### NEUE EMPFEHLUNGEN ###

# IDE- / Editor-Konfiguration
.vscode/
.idea/

# Flask-spezifischer Instanz-Ordner
# Gut für Konfigurationen oder die DB, die nicht versioniert werden sollen
instance/

# Test-Artefakte
.pytest_cache/
.coverage
htmlcov/

# Build- / Verteilungs-Artefakte
build/
dist/
*.egg-info/

# Log-Dateien
*.log

# Betriebssystem-spezifische Dateien
.DS_Store
Thumbs.db

# Backup-Dateien
*.bak
*.backup
*~

# Backup-Verzeichnis (DB-Kopien, NICHT die Prompt-Exports)
# WICHTIG: "backups/*.db" (ohne **) griff NUR fuer Dateien direkt in
# backups/, NICHT fuer Unterordner wie backups/manual/ - dadurch landete
# am 2026-09-13 eine echte DB-Kopie (backups/manual/database_*.db, inkl.
# verschluesselter API-Keys) in einem lokalen Rescue-Branch, der zwar nie
# gepusht wurde, aber durch die Luecke leicht hätte gepusht werden können.
# "**" deckt beliebige Unterordner-Tiefe ab.
backups/**/*.db
backups/**/*.db.gz
backups/**/*.sql
backups/**/*.sql.gz
# Prompt-Exports SOLLEN versioniert werden!
# backups/prompts_export/ wird NICHT ignoriert
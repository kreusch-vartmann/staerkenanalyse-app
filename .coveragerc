# Coverage.py Konfiguration

[run]
source = .
omit = 
    */venv/*
    */venv_py313_broken/*
    */tests/*
    */migrations/*
    */__pycache__/*
    */site-packages/*
    setup.py
    wsgi.py

[report]
precision = 2
show_missing = True
skip_covered = False

exclude_lines =
    # Standard-Ausschlüsse
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov
